.env
.env.local
.env.*.local
**/.env
**/.env.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# Test coverage
coverage/
.nyc_output/

# Docker volumes / local data (if any local mounts)
uploads/
**/uploads/

# Temporary files
tmp/
temp/
*.tmp
*.temp

# TypeScript cache
*.tsbuildinfo

# Optional npm cache
.npm/

# Debug
.debug/

# Prisma / Sequelize (if any local sqlite etc.)
*.sqlite
*.db

# Generated JWT keys (if stored as files)
*.pem
*.key
!*.example

# Frontend specific
frontend/dist/
frontend/.vite/

# Package lock alternatives (keep package-lock.json)
# yarn.lock
# pnpm-lock.yaml
